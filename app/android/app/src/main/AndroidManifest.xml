<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Réseau : synchronisation Google Sheets + suivi de connectivité.
         INTERNET est requis en release (le manifest debug ne suffit pas). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <application
        android:label="DTNH Assistant"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Thème appliqué dès le démarrage du process (splash), puis
                 remplacé par le NormalTheme quand Flutter rend sa 1re frame. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Retour de l'authentification Google (Supabase Auth) :
                 le navigateur revient dans l'application via ce schéma.
                 Doit correspondre à AppConfig.androidAuthCallbackScheme et
                 aux « Redirect URLs » configurées dans Supabase. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="mg.dtnh.dtnh_assistant_club"
                    android:host="login-callback"/>
            </intent-filter>
        </activity>
        <!-- Requis par le Flutter tool pour générer GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
